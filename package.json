{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.2",
  "private": true,
  "description": "An unofficial desktop client for DeepSeek Harness, with per-conversation CNY spend and an account balance readout.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "test": "node --test tests/runtime-staging.test.mjs tests/runtime-packaging.test.cjs tests/picker-runtime.test.cjs tests/runtime-startup.test.cjs tests/windows-branding.test.cjs tests/taskbar-identity.test.cjs",
    "test:build": "node --test tests/runtime-staging.test.mjs tests/runtime-packaging.test.cjs tests/windows-branding.test.cjs tests/taskbar-identity.test.cjs",
    "test:artifact": "node --test tests/windows-artifact.test.cjs",
    "audit:build": "npm audit --audit-level=high",
    "audit:runtime": "pnpm --dir runtime audit --prod --audit-level=high",
    "test:startup": "node --test tests/runtime-startup.test.cjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test:picker": "node --test tests/picker-runtime.test.cjs",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^42.10.1",
    "electron-builder": "26.15.3",
    "resedit": "1.7.2"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DSH Desktop",
    "copyright": "Copyright (c) 2026 DSH Desktop contributors",
    "afterPack": "scripts/brand-windows.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "build/icon.ico",
      "!runtime/**",
      "!dist/**",
      "!scripts/**",
      "!tests/**"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "runtime/**/*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.md",
          "!**/test/**",
          "!**/tests/**",
          "!**/.bin/**"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "artifactName": "DSH-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DSH-Desktop-Portable-${version}-${arch}.${ext}"
    },
    "compression": "maximum"
  }
}
