{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.1",
  "private": true,
  "description": "An unofficial desktop client for DeepSeek Harness, with per-conversation CNY spend and an account balance readout.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "test": "node --test tests/runtime-staging.test.mjs tests/picker-runtime.test.cjs tests/runtime-startup.test.cjs",
    "test:build": "node --test tests/runtime-staging.test.mjs",
    "test:startup": "node --test tests/runtime-startup.test.cjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test:picker": "node --test tests/picker-runtime.test.cjs",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^42.10.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DSH Desktop",
    "copyright": "Copyright (c) 2026 DSH Desktop contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "build/icon.ico",
      "!runtime/**",
      "!dist/**",
      "!scripts/**",
      "!tests/**"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/*.ts",
          "!**/*.md",
          "!**/test/**",
          "!**/tests/**",
          "!**/.bin/**"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "artifactName": "DSH-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DSH-Desktop-Portable-${version}-${arch}.${ext}"
    },
    "compression": "maximum"
  }
}
