+/**
+ * Static CNY price table for the DeepSeek official routes this harness ships
+ * by default, used to show an approximate session spend on {@link StatsLine}.
+ * DeepSeek's own docs (api-docs.deepseek.com/quick_start/pricing) publish
+ * off-peak USD rates only; this file converts them at a fixed approximate
+ * USD->CNY rate, so the figure is an estimate, not an invoice line. Peak-hour
+ * (2x) pricing is not modeled: the session projection this reads carries no
+ * per-request timestamp to key off.
+ */
+
+const USD_TO_CNY = 7.15
+
+interface ModelPrice {
+  /** CNY per million uncached input tokens. */
+  input: number
+  /** CNY per million cache-hit input tokens. */
+  cacheHit: number
+  /** CNY per million output tokens. */
+  output: number
+}
+
+function fromUsdPerMillion(amount: number): number {
+  return amount * USD_TO_CNY
+}
+
+const PRICE_TABLE_CNY: Record<string, ModelPrice> = {
+  'deepseek-v4-flash': {
+    input: fromUsdPerMillion(0.22),
+    cacheHit: fromUsdPerMillion(0.007),
+    output: fromUsdPerMillion(0.66),
+  },
+  'deepseek-v4-pro': {
+    input: fromUsdPerMillion(0.66),
+    cacheHit: fromUsdPerMillion(0.022),
+    output: fromUsdPerMillion(1.98),
+  },
+  // No separate published rate for the vision-preview route; it is the same
+  // base model family, so the plain Flash rate is a closer estimate than
+  // showing nothing.
+  'deepseek-v4-flash-vision-exp': {
+    input: fromUsdPerMillion(0.22),
+    cacheHit: fromUsdPerMillion(0.007),
+    output: fromUsdPerMillion(0.66),
+  },
+}
+
+/** The subset of {@link TokenUsageProjection} needed for a cost estimate. */
+export interface BillableTokenUsage {
+  uncachedInputTokens: number
+  cacheReadTokens: number
+  cacheWriteTokens: number
+  outputTokens: number
+}
+
+/**
+ * Estimate session spend in CNY for one model's accumulated usage.
+ *
+ * Cache-write tokens are priced at the plain input rate: DeepSeek's own usage
+ * accounting only ever reports a hit/miss split, so a non-zero write bucket
+ * (populated for other providers this harness can route to) has no dedicated
+ * DeepSeek rate to charge instead.
+ * @param usage - billed token buckets, e.g. the session's `tokenUsage` projection.
+ * @param modelId - the currently selected model id.
+ * @returns estimated CNY spend, or null when the model has no price entry
+ * (an unpriced or non-DeepSeek route).
+ */
+export function estimateSessionCostCNY(
+  usage: BillableTokenUsage,
+  modelId: string | undefined,
+): number | null {
+  if (modelId === undefined) return null
+  const price = PRICE_TABLE_CNY[modelId]
+  if (price === undefined) return null
+  return (usage.uncachedInputTokens + usage.cacheWriteTokens) / 1_000_000 * price.input
+    + usage.cacheReadTokens / 1_000_000 * price.cacheHit
+    + usage.outputTokens / 1_000_000 * price.output
+}
+
+/**
+ * Format a CNY amount for the compact stats line.
+ * @param amount - non-negative CNY amount.
+ * @returns two-decimal display string, floored at "<0.01" so a cheap turn
+ * does not read as free.
+ */
+export function formatCNY(amount: number): string {
+  if (amount > 0 && amount < 0.01) return '<0.01'
+  return amount.toFixed(2)
+}
