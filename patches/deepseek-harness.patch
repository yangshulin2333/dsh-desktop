+/**
+ * The DeepSeek account-balance route served by the llm-deepseek plugin
+ * (see that package's balance-route module). Read with a plain same-origin
+ * fetch rather than through the RPC client: the API key stays on the host and
+ * the whole payload is a handful of decimal strings, so the readout needs
+ * neither a generated Remote namespace nor a wire schema of its own.
+ */
+const BALANCE_ENDPOINT = '/deepseek/balance'
+
+/** One currency bucket as the route serves it. */
+interface BalanceEntry {
+  currency: string
+  totalBalance: string
+}
+
+/** The balance readout's own display state, independent of the editor's. */
+type BalanceState =
+  | { status: 'loading' }
+  | { status: 'ready'; balances: readonly BalanceEntry[] }
+  | { status: 'failed'; reason: string }
+
+/**
+ * Read the balance route, mapping every outcome onto one display state.
+ * @returns the state to render; never rejects.
+ */
+async function readBalance(): Promise<BalanceState> {
+  let response: Response
+  try {
+    response = await fetch(BALANCE_ENDPOINT, { headers: { accept: 'application/json' } })
+  } catch {
+    return { status: 'failed', reason: 'the local harness did not answer' }
+  }
+  let body: unknown
+  try {
+    body = await response.json()
+  } catch {
+    return { status: 'failed', reason: `HTTP ${String(response.status)}` }
+  }
+  if (!response.ok) {
+    const message = typeof body === 'object' && body !== null
+      ? (body as { error?: unknown }).error
+      : undefined
+    return { status: 'failed', reason: typeof message === 'string' ? message : `HTTP ${String(response.status)}` }
+  }
+  const balances = typeof body === 'object' && body !== null
+    ? (body as { balances?: unknown }).balances
+    : undefined
+  if (!Array.isArray(balances)) return { status: 'failed', reason: 'unexpected response shape' }
+  const rows: BalanceEntry[] = []
+  for (const entry of balances as unknown[]) {
+    if (entry === null || typeof entry !== 'object') continue
+    const { currency, totalBalance } = entry as { currency?: unknown; totalBalance?: unknown }
+    if (typeof currency !== 'string' || typeof totalBalance !== 'string') continue
+    rows.push({ currency, totalBalance })
+  }
+  return { status: 'ready', balances: rows }
+}
