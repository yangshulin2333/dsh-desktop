+/**
+ * `GET /deepseek/balance` — a read-only HTTP route exposing DeepSeek's
+ * `/user/balance` account endpoint to the Models settings page.
+ *
+ * Deliberately a plain webserver route rather than a Typert `@Remote` service:
+ * a Remote namespace would pull this package into the client type graph and
+ * the generated zod validators into the browser bundle, for one read whose
+ * whole payload is four decimal strings. The route keeps the API key on the
+ * host — the browser only ever sees the parsed amounts — and adds no
+ * cross-package build edges. Registered only when `ctx.webServer` exists, so
+ * the headless and TUI profiles are unaffected.
+ * @module @deepseek-ai/dsh-llm-deepseek/balance-route
+ */
+
+import type { IncomingMessage, ServerResponse } from 'node:http'
+import type { Context } from '@deepseek-ai/cordis'
+import { attributionHeaders } from '@deepseek-ai/dsh-llm'
+
+/** Absolute pathname this route claims. */
+export const BALANCE_ROUTE_PATH = '/deepseek/balance'
+
+/** One currency bucket, kept as the provider's own decimal strings. */
+export interface DeepSeekBalanceEntry {
+  currency: string
+  totalBalance: string
+  grantedBalance: string
+  toppedUpBalance: string
+}
+
+/** The successful response body this route serves. */
+export interface DeepSeekBalanceBody {
+  isAvailable: boolean
+  balances: DeepSeekBalanceEntry[]
+}
+
+/** What the route needs from the owning plugin's own resolution state. */
+export interface BalanceRouteDeps {
+  /** Current connection base URL (the same resolution the chat adapter uses). */
+  getBaseURL: () => string
+  /** Resolve the current API key, or throw the adapter's own missing-credential error. */
+  getApiKey: () => Promise<string>
+}
+
+/**
+ * The one `ctx.webServer` method this module calls. Declared structurally and
+ * read through an untyped `ctx.get`, rather than importing the webserver
+ * package's Context merge: a type-only import would still need a tsconfig
+ * project reference, and a build edge from the LLM adapter to the HTTP host is
+ * a steep price for one route. A profile without the service registers
+ * nothing, so the seam stays optional at runtime too.
+ */
+interface WebServerSeam {
+  register(route: {
+    kind: 'exact' | 'prefix'
+    path: string
+    handler: (req: IncomingMessage, res: ServerResponse) => void | Promise<void>
+  }): () => void
+}
+
+interface WireEntry {
+  currency?: unknown
+  total_balance?: unknown
+  granted_balance?: unknown
+  topped_up_balance?: unknown
+}
+
+interface WireResponse {
+  is_available?: unknown
+  balance_infos?: unknown
+}
+
+/**
+ * Validate the untrusted provider JSON.
+ * @param value - parsed provider response.
+ * @returns the normalized body, or undefined when the shape does not match.
+ */
+export function parseBalance(value: unknown): DeepSeekBalanceBody | undefined {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) return undefined
+  const wire = value as WireResponse
+  if (typeof wire.is_available !== 'boolean' || !Array.isArray(wire.balance_infos)) return undefined
+  const balances: DeepSeekBalanceEntry[] = []
+  for (const entry of wire.balance_infos as unknown[]) {
+    if (entry === null || typeof entry !== 'object' || Array.isArray(entry)) return undefined
+    const fields = entry as WireEntry
+    if (typeof fields.currency !== 'string'
+      || typeof fields.total_balance !== 'string'
+      || typeof fields.granted_balance !== 'string'
+      || typeof fields.topped_up_balance !== 'string') {
+      return undefined
+    }
+    balances.push({
+      currency: fields.currency,
+      totalBalance: fields.total_balance,
+      grantedBalance: fields.granted_balance,
+      toppedUpBalance: fields.topped_up_balance,
+    })
+  }
+  return { isAvailable: wire.is_available, balances }
+}
+
+/** Write one JSON response, closing it. */
+function sendJson(res: ServerResponse, status: number, body: unknown): void {
+  const payload = JSON.stringify(body)
+  res.writeHead(status, {
+    'content-type': 'application/json; charset=utf-8',
+    'content-length': String(Buffer.byteLength(payload)),
+    // A balance is a live figure; a cached 200 would show a stale amount after
+    // the account is topped up.
+    'cache-control': 'no-store',
+  })
+  res.end(payload)
+}
+
+/**
+ * Register the balance route on `ctx.webServer` when that service is present.
+ *
+ * Every failure answers with a JSON `{ error }` body and a status the page can
+ * render as "unavailable": a missing key or an upstream refusal is an ordinary
+ * state of this readout, not a server fault.
+ * @param ctx - the owning `llm-deepseek` plugin context.
+ * @param deps - the two resolution closures shared with the chat adapter.
+ */
+export function registerBalanceRoute(ctx: Context, deps: BalanceRouteDeps): void {
+  const handler = async (req: IncomingMessage, res: ServerResponse): Promise<void> => {
+    if (req.method !== 'GET') {
+      sendJson(res, 405, { error: 'method not allowed' })
+      return
+    }
+    let apiKey: string
+    try {
+      apiKey = await deps.getApiKey()
+    } catch (error) {
+      sendJson(res, 409, { error: error instanceof Error ? error.message : String(error) })
+      return
+    }
+    const baseURL = deps.getBaseURL().replace(/\/+$/u, '')
+    let upstream: Response
+    try {
+      upstream = await fetch(`${baseURL}/user/balance`, {
+        headers: { ...attributionHeaders(), authorization: `Bearer ${apiKey}` },
+      })
+    } catch {
+      sendJson(res, 502, { error: `could not reach ${baseURL}` })
+      return
+    }
+    if (!upstream.ok) {
+      sendJson(res, 502, { error: `provider returned HTTP ${String(upstream.status)}` })
+      return
+    }
+    let parsed: unknown
+    try {
+      parsed = await upstream.json()
+    } catch {
+      sendJson(res, 502, { error: 'provider returned a non-JSON response' })
+      return
+    }
+    const body = parseBalance(parsed)
+    if (body === undefined) {
+      sendJson(res, 502, { error: 'provider returned an unexpected shape' })
+      return
+    }
+    sendJson(res, 200, body)
+  }
+
+  // Scoped inject rather than a read at this plugin's own apply time: the web
+  // server activates after the LLM adapters, so a direct `ctx.get` would
+  // always miss it. A profile that never provides one (headless, TUI) simply
+  // never runs this callback.
+  ctx.inject(['webServer'], (scope) => {
+    const webServer = scope.get('webServer' as never) as unknown as WebServerSeam
+    scope.effect(
+      () => webServer.register({ kind: 'exact', path: BALANCE_ROUTE_PATH, handler }),
+      'llm-deepseek: balance route',
+    )
+  })
+}
