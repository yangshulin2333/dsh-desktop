@@ -0,0 +1,35 @@
+/** Read-only DeepSeek account balance; credentials never enter the returned value. */
+export interface AccountBalance {
+  currency: string
+  total: string
+  granted: string
+  toppedUp: string
+}
+
+/**
+ * Query the official endpoint without following redirects with a bearer token.
+ * @param key - Host-resolved API key.
+ * @param signal - Caller cancellation.
+ * @returns Validated decimal balance rows.
+ */
+export async function fetchAccountBalance(key: string, signal?: AbortSignal): Promise<AccountBalance[]> {
+  const response = await fetch('https://api.deepseek.com/user/balance', {
+    headers: { Authorization: `Bearer ${key}` }, redirect: 'error',
+    signal: signal === undefined ? AbortSignal.timeout(10000) : AbortSignal.any([signal, AbortSignal.timeout(10000)]),
+  })
+  if (!response.ok) throw new Error(`Balance request failed (HTTP ${response.status})`)
+  const value: unknown = await response.json()
+  if (typeof value !== 'object' || value === null || !('balance_infos' in value)
+    || !Array.isArray(value.balance_infos) || value.balance_infos.length === 0) throw new Error('Invalid balance response')
+  return value.balance_infos.map((row: unknown) => {
+    if (typeof row !== 'object' || row === null) throw new Error('Invalid balance row')
+    const data = row as Record<string, unknown>
+    if (typeof data['currency'] !== 'string' || !['CNY', 'USD'].includes(data['currency'])) throw new Error('Invalid balance currency')
+    const amount = (name: string): string => {
+      const v = data[name]
+      if (typeof v !== 'string' || !/^-?\d+(?:\.\d+)?$/u.test(v)) throw new Error('Invalid balance amount')
+      return v
+    }
+    return { currency: data['currency'], total: amount('total_balance'), granted: amount('granted_balance'), toppedUp: amount('topped_up_balance') }
+  })
+}
