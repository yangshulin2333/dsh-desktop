@@ -0,0 +1,33 @@
+import { useRef, useState, useEffect } from 'react'
+import type { ProviderEditorProps } from './ProviderEditor.tsx'
+import styles from './ModelsSection.module.css'
+
+/** Display only the saved account balance; unsaved key edits are never sent. */
+export function AccountBalance({ operations, provider, t }: Pick<ProviderEditorProps, 'operations' | 'provider' | 't'>) {
+  const [text, setText] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [failed, setFailed] = useState(false)
+  const generation = useRef(0)
+  useEffect(() => () => { generation.current += 1 }, [])
+  const refresh = async () => {
+    const current = ++generation.current
+    setBusy(true)
+    setText('')
+    setFailed(false)
+    try {
+      const rows = await operations.readAccountBalance?.(provider)
+      if (current !== generation.current) return
+      if (rows === undefined) throw new Error('Unsupported host')
+      setText(rows.map(row => `${row.currency} ${row.total}`).join(' · '))
+    } catch {
+      if (current === generation.current) setFailed(true)
+    } finally {
+      if (current === generation.current) setBusy(false)
+    }
+  }
+  return <section aria-label={t('accountBalance')}>
+    <p>{t('accountBalance')}: <span role="status">{failed ? t('balanceFailed') : text || t('balanceNotQueried')}</span></p>
+    <button className={styles['secondaryButton']} type="button" disabled={busy} onClick={() => { void refresh() }}>{busy ? t('balanceLoading') : t('balanceRefresh')}</button>
+    <p>{t('balanceSavedKey')}</p>
+  </section>
+}
