+import { describe, expect, it } from 'vitest'
+import { estimateRequestCosts, type CostAttempt } from '../src/client/chat/request-cost.ts'
+const sample: CostAttempt = { startedAt: Date.parse('2026-09-12T02:00:00Z'), inputTokens: 1000000, cacheReadTokens: 1000000, cacheWriteTokens: 0, outputTokens: 1000000, totalTokens: 3000000, route: { provider: 'deepseek-official', model: 'deepseek-flash' } }
+describe('per-request CNY estimates', () => {
+  it('prices Saturday as off-peak and weekday peak at twice the rate', () => {
+    expect(estimateRequestCosts([sample])?.total).toBeCloseTo(5.02)
+    expect(estimateRequestCosts([{ ...sample, startedAt: Date.parse('2026-09-11T02:00:00Z') }])?.total).toBeCloseTo(10.04)
+  })
+  it('uses each original model rather than the currently selected one', () => {
+    const result = estimateRequestCosts([sample, { ...sample, route: { provider: 'deepseek-official', model: 'deepseek-v4-pro' } }])
+    expect(result?.requests).toEqual([5.02, 18.15])
+    expect(result?.total).toBeCloseTo(23.17)
+  })
+  it('does not invent prices for unsupported or incomplete requests', () => {
+    expect(estimateRequestCosts([{ ...sample, route: { provider: 'other', model: 'deepseek-flash' } }])).toBeUndefined()
+    expect(estimateRequestCosts([{ ...sample, totalTokens: 1 }])).toBeUndefined()
+    expect(estimateRequestCosts(undefined)).toBeUndefined()
+  })
+})
