index 0000000..b36d786
--- /dev/null
+++ b/packages/client/ui-chat/src/client/chat/request-cost.ts
@@ -0,0 +1,37 @@
+/** One recorded provider attempt, retaining its original model and launch time. */
+export interface CostAttempt {
+  readonly startedAt: number
+  readonly inputTokens: number
+  readonly outputTokens: number
+  readonly totalTokens: number
+  readonly cacheReadTokens?: number
+  readonly cacheWriteTokens?: number
+  readonly route?: { readonly provider: string; readonly model: string }
+}
+
+/**
+ * Estimate CNY using the official 2026-09-12 price table, not account deductions.
+ * @param attempts - Original per-attempt samples; missing attribution is not guessed.
+ * @returns Per-request estimates and their sum, or undefined for incomplete/unsupported billing.
+ */
+export function estimateRequestCosts(attempts: readonly CostAttempt[] | undefined): { total: number; requests: number[] } | undefined {
+  if (attempts === undefined || attempts.length === 0) return undefined
+  const requests: number[] = []
+  for (const sample of attempts) {
+    const route = sample.route
+    if (route?.provider !== 'deepseek-official' || sample.cacheReadTokens === undefined
+      || (sample.cacheWriteTokens ?? 0) !== 0) return undefined
+    const rates = route.model === 'deepseek-v4-pro' ? [4.5, 0.15, 13.5]
+      : ['deepseek-flash', 'deepseek-v4-flash', 'deepseek-v4-flash-vision-exp'].includes(route.model) ? [1, 0.02, 4] : undefined
+    if (rates === undefined) return undefined
+    const counts = [sample.inputTokens, sample.cacheReadTokens, sample.outputTokens]
+    if (counts.some(value => !Number.isSafeInteger(value) || value < 0)
+      || counts.reduce((a, b) => a + b, 0) !== sample.totalTokens) return undefined
+    const time = new Date(sample.startedAt)
+    if (!Number.isFinite(time.getTime())) return undefined
+    const hour = time.getUTCHours(), day = time.getUTCDay()
+    const peak = day >= 1 && day <= 5 && ((hour >= 1 && hour < 4) || (hour >= 6 && hour < 10))
+    requests.push(counts.reduce((sum, count, index) => sum + count * (rates[index] ?? 0), 0) / 1e6 * (peak ? 2 : 1))
+  }
+  return { total: requests.reduce((a, b) => a + b, 0), requests }
+}
